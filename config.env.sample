# Use URL-safe hexadecimal characters for MYSQL_PASSWORD because Compose also inserts it in DATABASE_URL.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-hex-value
MYSQL_PASSWORD=replace-with-a-long-random-hex-value

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-with-your-local-provider-key
LLM_EXTRA_BODY_JSON={}

# Compose demo default; see the README for the measured byte-estimator rationale.
INPUT_TOKEN_BUDGET=6144
MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1
CHAT_DEADLINE_SECONDS=150
TURN_LEASE_SECONDS=180

# Set this only when running local MySQL integration tests.
TEST_DATABASE_URL=mysql+asyncmy://commerce_support:replace-with-the-same-random-hex-value@127.0.0.1:3307/commerce_support_test_task1
